    SpawnObjectEvent([in] string Key, [in] int templetedID, [in] float px, [in] float py, [in] float pz);
    
    OtherPlayerTransformUpdated([in] int ClientID, [in] string NickName, 
                                [in] float ScaleX, [in] float ScaleY, [in] float ScaleZ,
                                [in] float AngleX, [in] float AngleY, [in] float AngleZ, [in] float AngleW,
                                [in] float PosX, [in] float PosY, [in] float PosZ); 

    OnPlayerTransformUpdated([in] int clientId, 
                             [in] float ScaleX, [in] float ScaleY, [in] float ScaleZ,
                             [in] float AngleX, [in] float AngleY, [in] float AngleZ, [in] float AngleW,
                             [in] float PosX, [in] float PosY, [in] float PosZ);
    
    OtherActorTransformUpdated([in] int templeteID, 
                               [in] float ScaleX, [in] float ScaleY, [in] float ScaleZ,
                               [in] float AngleX, [in] float AngleY, [in] float AngleZ, [in] float AngleW,
                               [in] float PosX, [in] float PosY, [in] float PosZ);

    ActorTransformUpdated([in] int templeteID, 
                      [in] float ScaleX, [in] float ScaleY, [in] float ScaleZ,
                      [in] float AngleX, [in] float AngleY, [in] float AngleZ, [in] float AngleW,
                      [in] float PosX, [in] float PosY, [in] float PosZ);

    
    UpdateCharacterAnimState([in] int clientId, [in] int AnimSate, [in] float Time);
    OnOtherPlayerAnimUpdated([in] int ClientID, [in] int AnimState, [in] int AnimTime);

    UpdateActorAnimState([in] int templeteID, [in] int AnimSate, [in] float Time);
    OnOtherActorAnimUpdated([in] int templeteID, [in] int AnimState, [in] int AnimTime);

    // Inventory Item에 관한 데이터
