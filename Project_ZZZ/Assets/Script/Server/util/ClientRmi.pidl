global ClientToServer 2000
{
    OnGameLogin([in] int clientId,[in] int LoginType, [in] string szID, [in] string szPassWord, [in] string uid, [in] string email);
    Create_Character([in] int clientId, [in] string szNickName);

    SpawnObjectEvent([in] int LevelID, [in] int SpawnPointID, [in] int Type);
    SpawnPlayerEvent([in] int clientId, [in] int iLevelID);

    RequestCheckNickname([in] int clientId, [in] string szNickName);

    OnPositionUpdated([in] int clientId, 
                      [in] float PosX, [in] float PosY, [in] float PosZ, 
                      [in] float DirX, [in] float DirY, [in] float DirZ);

    OnActorPositionUpdated([in] int templeteID, 
                      [in] float PosX, [in] float PosY, [in] float PosZ, 
                      [in] float DirX, [in] float DirY, [in] float DirZ);

    OnAnimUpdated([in] int clientId, [in] int AnimStae, [in] float Time);
    OnActorAnimUpdated([in] int templeteID, [in] int AnimStae, [in] float Time);

    // Inventory Item에 관한 데이터
    Request_AddItem([in] int iClientID, [in] int iItemID, [in] int iItemCount);
    Request_RemoveItem([in] int iClientID, [in] int iItemID, [in] int SlotIndex, [in] int iItemCount);
    Request_ItemData([in] int iClientID, [in] int iItemID);

    Request_AddGold([in] int ClientID, [in] int GoldAmount);

    OnChat([in] int clientId, [in] string message);
}